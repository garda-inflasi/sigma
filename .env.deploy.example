# ==============================================================================
#  Garda Inflasi — .env.deploy.example
#  Template konfigurasi deploy (build di Mac → transfer → jalankan di VM).
#  Tanpa Git: setiap rilis diberi tag timestamp (atau --tag=<versi>).
#
#  Cara pakai:
#      make deploy/init-env      # menyalin file ini ke .env.deploy
#      $EDITOR .env.deploy       # isi kredensial & konfigurasi VM
#      make deploy/init-vm       # bootstrap awal (grup docker, folder, .env VM)
#      make deploy               # full deploy
#      make deploy ARGS=--only=web  # update parsial layanan tertentu saja
#
#  ⚠️  .env.deploy TIDAK PERNAH dikirim ke VM. File ini hanya berisi kredensial
#      akses SSH + parameter build. Rahasia aplikasi ada di .env milik VM.
# ==============================================================================

# ------------------------------------------------------------------------------
#  VM TARGET
# ------------------------------------------------------------------------------
# Hostname atau IP VM tujuan.
VM_HOST=43.173.39.71
# User SSH di VM.
VM_USER=ubuntu
# Password SSH (opsional jika menggunakan SSH_KEY_PATH).
# Jika SSH_PASSWORD diisi, wrapper memakai sshpass atau expect otomatis.
SSH_PASSWORD=
# Path private key SSH (opsional, dipakai jika SSH_PASSWORD kosong; mode 600).
SSH_KEY_PATH=
# Port SSH VM.
SSH_PORT=22
# Direktori kerja deploy di VM.
REMOTE_DIR=/home/ubuntu/garda-inflasi

# ------------------------------------------------------------------------------
#  GATEWAY (CADDY EXISTING DI SERVER)
# ------------------------------------------------------------------------------
# external = memakai Caddy gateway existing di VM (tanpa menjalankan container caddy app)
# builtin  = menjalankan service caddy bawaan compose.yaml
GATEWAY_MODE=external
# Lokasi folder compose & Caddyfile gateway existing di VM.
GATEWAY_CADDY_DIR=/home/ubuntu/caddy-gardainflasi
# Nama network Docker milik Caddy existing di VM.
GATEWAY_NETWORK=caddy-gardainflasi_edge
# Domain utama aplikasi dan domain apex (redirect ke PUBLIC_HOST jika berbeda).
PUBLIC_HOST=app.gardainflasi.id
APEX_HOST=gardainflasi.id

# ------------------------------------------------------------------------------
#  BUILD
# ------------------------------------------------------------------------------
# Platform target image. Mac Apple Silicon → VM x86_64: linux/amd64.
TARGET_PLATFORM=linux/amd64
# Prefix nama image lokal (garda-api, garda-web, garda-ml).
IMAGE_TAG_PREFIX=garda
# Berapa versi image lama yang disimpan di VM (sisanya di-prune).
KEEP_LAST_N_IMAGES=3
# Direktori cache buildx lokal (mempercepat build berikutnya).
BUILDX_CACHE_DIR=.buildx-cache

# ------------------------------------------------------------------------------
#  APP BUILD ARGS (di-inline ke bundle browser saat `next build`)
# ------------------------------------------------------------------------------
# HARUS relatif ("/api") agar browser selalu memanggil origin yang sama.
NEXT_PUBLIC_API_BASE_URL=/api
# Origin publik aplikasi (dipakai validasi CSRF di lapisan BFF).
NEXT_PUBLIC_APP_URL=https://app.gardainflasi.id

# ------------------------------------------------------------------------------
#  SSH TUNING (opsional)
# ------------------------------------------------------------------------------
SSH_CONNECT_TIMEOUT=15
SSH_ALIVE_INTERVAL=30
SSH_ALIVE_COUNT_MAX=3
