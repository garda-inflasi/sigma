# ==============================================================================
#  Garda Inflasi — .env.deploy.example
#  Template konfigurasi deploy (build di Mac → transfer → jalankan di VM).
#
#  Cara pakai:
#      make deploy/init-env      # menyalin file ini ke .env.deploy
#      $EDITOR .env.deploy       # isi nilainya
#      make deploy
#
#  ⚠️  .env.deploy TIDAK PERNAH dikirim ke VM. File ini hanya berisi kredensial
#      akses SSH + parameter build. Rahasia aplikasi ada di .env milik VM.
# ==============================================================================

# ------------------------------------------------------------------------------
#  VM TARGET
# ------------------------------------------------------------------------------
# Hostname atau IP VM tujuan.
VM_HOST=192.168.1.100
# User SSH di VM (harus punya akses ke Docker daemon).
VM_USER=deploy
# Path private key SSH. WAJIB mode 600 (chmod 600 ~/.ssh/garda_vm).
SSH_KEY_PATH=~/.ssh/garda_vm
# Port SSH VM.
SSH_PORT=22
# Direktori kerja deploy di VM (dibuat otomatis bila belum ada).
REMOTE_DIR=/home/deploy/garda-inflasi

# ------------------------------------------------------------------------------
#  BUILD
# ------------------------------------------------------------------------------
# Platform target image. Mac Apple Silicon → VM amd64: linux/amd64.
# VM arm64 (mis. Raspberry Pi / Graviton): linux/arm64.
TARGET_PLATFORM=linux/amd64
# Prefix nama image lokal (garda-api, garda-web, garda-caddy).
IMAGE_TAG_PREFIX=garda
# Berapa versi image lama yang disimpan di VM (sisanya di-prune).
KEEP_LAST_N_IMAGES=3
# Direktori cache buildx lokal (mempercepat build berikutnya).
BUILDX_CACHE_DIR=.buildx-cache

# ------------------------------------------------------------------------------
#  APP BUILD ARGS (di-inline ke bundle browser saat `next build`)
# ------------------------------------------------------------------------------
# HARUS relatif ("/api") agar browser selalu memanggil origin yang sama.
# URL absolut membuat http://host dan https://host jadi origin berbeda → CORS.
NEXT_PUBLIC_API_BASE_URL=/api
# Origin publik aplikasi (dipakai validasi CSRF di lapisan BFF).
NEXT_PUBLIC_APP_URL=https://app.garda.id
# Mapbox (opsional). Kosongkan bila peta memakai skema SVG.
NEXT_PUBLIC_MAPBOX_TOKEN=

# ------------------------------------------------------------------------------
#  RUNTIME (opsional — hanya dipakai oleh `make status`)
# ------------------------------------------------------------------------------
# Domain publik untuk healthcheck eksternal. Kosongkan bila belum ada DNS.
PUBLIC_HOST=app.garda.id

# ------------------------------------------------------------------------------
#  SSH TUNING (opsional)
# ------------------------------------------------------------------------------
SSH_CONNECT_TIMEOUT=10
SSH_ALIVE_INTERVAL=30
SSH_ALIVE_COUNT_MAX=3