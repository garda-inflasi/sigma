# ── Server ──────────────────────────────────────────────────────────
APP_ADDR=:8080
GIN_MODE=debug

# ── Database ───────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=garda
DB_PASSWORD=garda_secret
DB_NAME=garda_inflasi
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m

# ── Redis ──────────────────────────────────────────────────────────────
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ── JWT ────────────────────────────────────────────────────────────────
JWT_SECRET=garda-inflasi-dev-secret-key-change-in-production

# ── AES Encryption ─────────────────────────────────────────────────────
AES_KEY=0123456789abcdef0123456789abcdef

# ── CORS ───────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Rate Limiting ──────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m
