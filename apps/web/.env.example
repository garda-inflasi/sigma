# ── Backend utama (Golang). Kosongkan untuk mode mock (UI berjalan tanpa backend).
NEXT_PUBLIC_API_BASE_URL=
# ── Mapbox (peta operasional & spasial). Tanpa token, peta memakai fallback SVG.
NEXT_PUBLIC_MAPBOX_TOKEN=
# ── PostgreSQL (dipakai Prisma untuk skema + seeder; dibaca juga oleh layanan Go)
DATABASE_URL=postgresql://garda:garda@localhost:5432/garda_inflasi?schema=public
# ── Verifikasi sesi di proxy.ts (HS256, diterbitkan layanan auth Go setelah SSO + MFA)
GARDA_JWT_SECRET=ganti-dengan-secret-minimal-32-karakter
# ── Password awal akun seeder (hanya untuk lingkungan dev/staging)
SEED_PASSWORD=
