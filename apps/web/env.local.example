# ==============================================================================
#  Garda Inflasi — Frontend (Next.js 16)  ·  apps/web/.env.local
# ==============================================================================
#  Salin file ini ke apps/web/.env.local lalu sesuaikan:
#      cp apps/web/env.local.example apps/web/.env.local
#
#  Ringkas: salin dari blok FRONTEND (bagian 3) di env.example root.
# ==============================================================================

# Variabel PUBLIK (dibundel ke bundle browser, prefix NEXT_PUBLIC_)
# URL layanan Go. KOSONGKAN untuk mengaktifkan mode mock (UI jalan tanpa backend).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# Origin aplikasi — dipakai validasi CSRF & safe-redirect (lapisan BFF).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Mapbox (opsional). Kosong => peta memakai skema SVG Aceh.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Server-only (BFF: Route Handler / Server Action, tidak terekspos ke browser)
# Base URL backend Go untuk panggilan server-to-server.
GO_API_BASE_URL=http://localhost:8080/v1
# Harus SAMA PERSIS dengan JWT_SECRET backend agar verifikasi JWT (jose) berhasil.
GARDA_JWT_SECRET=garda-inflasi-dev-secret-key-change-in-production
