# ==============================================================================
#  Garda Inflasi — Konfigurasi Environment (Local Development)
# ==============================================================================
#  Satu file env untuk seluruh monorepo (backend Go + frontend Next.js + Docker).
#
#  Cara pakai:
#      cp env.example .env        # backend & Docker memakai .env
#      cp env.example env.local   # lalu salin blok FRONTEND ke apps/web/.env.local
#
#  Bagaimana tiap komponen membaca konfigurasi ini:
#    • Docker Compose   : otomatis membaca `.env` di root (satu folder dgn compose.yaml)
#    • Backend Go (Gin) : membaca process env. Jalankan via `make dev/api`
#                         (Makefile memuat `.env` via `-include` + `export`),
#                         atau manual:  set -a; . ./.env; set +a
#    • Frontend Next.js : membaca apps/web/.env.local — salin blok "FRONTEND" (bagian 3)
#                         ke file tsb, atau jalankan via `make dev/web`.
# ==============================================================================

# ------------------------------------------------------------------------------
#  1. RUNTIME UMUM
# ------------------------------------------------------------------------------
NODE_ENV=development
TZ=Asia/Jakarta

# ------------------------------------------------------------------------------
#  2. BACKEND — Go / Gin  (apps/api)
# ------------------------------------------------------------------------------
# Alamat bind HTTP server (default :8080 bila kosong)
APP_ADDR=:8080
# Mode Gin: debug | release | test
GIN_MODE=debug
# Lingkungan aplikasi. `production` membuat `cmd/seed demo` menolak berjalan DAN API/worker
# menolak start bila JWT_SECRET/AES_KEY/DB_PASSWORD masih bawaan atau lemah.
APP_ENV=development
# Origin browser yang boleh mengubah data lewat cookie (proteksi CSRF di Go dan BFF),
# dipisah koma. Sertakan origin publik (Caddy) bila memakai port selain 80/443.
APP_ALLOWED_ORIGINS=http://localhost:3000,http://localhost,https://localhost
# Batas permintaan API per menit per IP klien (bawaan 600; satu halaman dashboard memanggil
# belasan endpoint, dan satu kantor bisa berbagi satu IP publik).
API_RATE_LIMIT_PER_MENIT=
# Batas percobaan per menit per IP klien ke endpoint auth publik di Go: login, validasi OTP, lupa/atur
# ulang kata sandi, dan mulai/selesai SSO (bawaan 10). Caddy membuka /api/v1/* langsung ke Go sehingga jalur
# itu tidak melewati batas laju login BFF (5/menit/IP); ini pagarnya. Permintaan yang ditolak dijawab 429
# RATE_LIMITED dengan Retry-After (kontrak yang sama dengan BFF). e2e Playwright login ke API Go langsung
# ratusan kali per putaran, jadi stack demo (`make docker/demo/up`) mengisinya 100000; jangan memakai nilai itu
# di produksi.
AUTH_RATE_LIMIT_PER_MENIT=
# Proxy yang dipercaya mengisi X-Forwarded-For, CIDR dipisah koma. Kosong = loopback dan
# jaringan privat (Caddy di jaringan Docker); "none" = tidak ada.
TRUSTED_PROXIES=

# --- PostgreSQL — dibaca oleh pkg/database (prefix DB_) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=garda
DB_PASSWORD=garda_secret
DB_NAME=garda_inflasi
DB_SSLMODE=disable

# Login DB berhak minimum untuk api dan worker (03-C, docs/todos/19 §7): anggota peran garda_aplikasi, tanpa DDL dan
# tanpa UPDATE/DELETE pada jejak audit. Dibuat/diperbarui oleh cmd/migrate sesudah migrasi bila keduanya diisi; di
# Docker, api dan worker lalu terhubung dengannya (migrate dan seed tetap memakai DB_USER pemilik skema). Lokal
# (make dev/api) tetap memakai DB_USER. Sandi minimal 16 karakter ASCII tanpa spasi (mis. openssl rand -base64 32).
# DB_APP_USER=garda_app
# DB_APP_PASSWORD=

# --- DSN tunggal — dipakai cmd/seed & goose (Makefile: db/migrate, db/seed) ---
DATABASE_URL=postgres://garda:garda_secret@localhost:5432/garda_inflasi?sslmode=disable

# --- Migrasi & seed (make db/migrate, make db/seed/*) ---
# Akun admin awal untuk `make db/seed/admin` (diisi bila seeder admin dipakai).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Layanan ML (apps/ml, Python). Kosong => pelatihan model menjawab 503, data demo tetap tampil. ---
# Compose memakai http://ml:8000; lokal: `cd apps/ml && python3 -m garda_ml` lalu http://localhost:8000.
ML_SERVICE_URL=

# --- LLM untuk generator policy brief. Kosong => brief disusun dari templat deterministik (demo tetap jalan). ---
# Kunci API Anthropic: isi hanya di .env lokal / rahasia deployment, jangan pernah di-commit.
ANTHROPIC_API_KEY=
# Model untuk narasi brief (bawaan claude-opus-5-5); harus mendukung structured outputs dan output_config.effort.
# Untuk claude-opus-5-5, claude-opus-5, claude-sonnet-5-5, dan claude-fable-5-1 fallback server-side aktif:
# permintaan yang ditolak pengaman model dijalankan ulang otomatis pada model pengganti.
# Alamat API dapat diganti dengan ANTHROPIC_BASE_URL (mis. gateway internal).
LLM_MODEL=claude-opus-5-5

# --- Autentikasi & kriptografi ---
# JWT HS256 — minimal 32 karakter. WAJIB sama dengan GARDA_JWT_SECRET (frontend).
JWT_SECRET=garda-inflasi-dev-secret-key-change-in-production
# AES-256-GCM — WAJIB tepat 32 byte (32 karakter ASCII). Menyegel rahasia TOTP (MFA) di basis data; versi
# kunci disimpan bersama data ("v1:..."). Di produksi (APP_ENV=production) nilai contoh ini ditolak dan
# kunci wajib diisi; ganti kunci tanpa migrasi ulang membuat MFA semua pengguna tidak terbaca.
AES_KEY=0123456789abcdef0123456789abcdef
# Mewajibkan MFA bagi peran strategis, manajerial, koordinator lapangan, admin, dan akun bertanda wajib MFA:
# sebelum setup, sesi mereka hanya membuka endpoint setup MFA. Kosong = true di produksi, false selain itu
# (lokal/demo tetap bisa masuk tanpa setup). Akun yang sudah mengaktifkan MFA selalu ditantang kode OTP.
MFA_ENFORCE=

# --- Masuk dengan Google (SSO, OpenID Connect + PKCE) — opsional ---
# SSO aktif hanya bila SSO_GOOGLE_CLIENT_ID terisi; kosong = tombol "Masuk dengan Google" disembunyikan dan
# rute SSO menjawab 503 SSO_NOT_CONFIGURED. Akun harus sudah ada dan AKTIF (tidak ada pendaftaran mandiri).
# Google: buat OAuth client (Web application) di Google Cloud Console, daftarkan redirect URI
# <origin publik>/api/auth/sso/google/callback, lalu isi nilai di bawah (lihat docs/DEPLOYMENT.md §3.7).
# Di produksi prodcheck mewajibkan secret, redirect URL https yang tepat, dan origin-nya ada di APP_ALLOWED_ORIGINS.
SSO_GOOGLE_CLIENT_ID=
SSO_GOOGLE_CLIENT_SECRET=
# Kosong = https://accounts.google.com. Lokal/demo: mock OIDC (profil compose sso-mock), mis.
# http://sso.localhost:8089/default; `make docker/demo/up` mengisi semua SSO_GOOGLE_* untuk demo.
SSO_GOOGLE_ISSUER=
# Alamat callback BFF Next.js; harus sama persis dengan yang didaftarkan di penyedia. Lokal tanpa Docker:
# http://localhost:3000/api/auth/sso/google/callback
SSO_GOOGLE_REDIRECT_URL=
# Opsional: hanya akun Google Workspace dengan klaim hd ini yang diterima, mis. kemenkeu.go.id.
SSO_GOOGLE_HOSTED_DOMAIN=

# --- Job berkala (cmd/worker). Interval durasi Go; "off" menonaktifkan ---
# JOB_DASHBOARD_REFRESH_INTERVAL=5m
# JOB_KPI_HITUNG_INTERVAL=1h
# JOB_KPI_HITUNG_BULAN=2
# Pembersihan baris auth yang sudah mati: jwt_blacklist & refresh_tokens kedaluwarsa (refresh token yang
# dicabut tapi belum kedaluwarsa dipertahankan untuk deteksi pemakaian ulang), password_reset_tokens
# kedaluwarsa/terpakai, dan login_attempts yang lewat masa simpan. Dihapus per batch.
# JOB_AUTH_PEMBERSIHAN_INTERVAL=1h
# Masa simpan login_attempts (hari, minimal 1 sebagai lantai pelindung penguncian akun; off = tidak dihapus).
# JOB_AUTH_PEMBERSIHAN_LOGIN_HARI=90
# Masa simpan token reset sesudah kedaluwarsa/terpakai (hari; 0 = langsung dihapus).
# JOB_AUTH_PEMBERSIHAN_RESET_HARI=7
# Baris maksimum per pernyataan DELETE.
# JOB_AUTH_PEMBERSIHAN_BATCH=1000
# Integritas audit (03-C): partisi bulanan audit_log disiapkan di depan, rantai hash diverifikasi ulang berkala.
# JOB_AUDIT_PARTISI_INTERVAL=24h
# JOB_AUDIT_VERIFIKASI_INTERVAL=24h
# Partisi bulanan yang disiapkan di depan bulan ini (0..24).
# AUDIT_PARTISI_KE_DEPAN=3
# Retensi: partisi yang seluruhnya lebih tua dari N bulan (12..1200) diekspor ke AUDIT_ARSIP_DIR (jsonl.gz + manifest)
# lalu dilepas dari basis data. Kosong = retensi mati. Salin direktori arsip ke penyimpanan di luar server.
# AUDIT_RETENSI_BULAN=60
# AUDIT_ARSIP_DIR=./arsip/audit
# WORKER_HEALTH_ADDR=:8081
# Set false bila cmd/worker berjalan, agar API tidak ikut menjadwalkan refresh dashboard.
# API_BACKGROUND_JOBS=true
# Swagger UI: aktif selain GIN_MODE=release; paksa dengan true/false.
# SWAGGER_ENABLED=

# --- Ingestion sumber data eksternal (opsional; lihat apps/api/README.md) ---
# Penjadwal cron ingestion di cmd/worker. Bawaan MATI agar lokal/demo tidak memanggil internet.
# Isi "on" hanya di lingkungan yang boleh mengakses PIHPS, BMKG, dan BPS.
INGEST_SCHEDULER=
# Kunci API BPS WebAPI (webapi.bps.go.id); tanpa ini ingestion SRC-BPS gagal dengan pesan jelas.
BPS_API_KEY=
# User-Agent permintaan keluar dan jeda minimum (ms) antar permintaan ke host yang sama.
INGEST_USER_AGENT=
INGEST_JEDA_MS=

# --- Redis — pub/sub aliran SSE EWS antar-instance (opsional; tanpa Redis memakai polling DB) ---
REDIS_URL=redis://localhost:6379

# --- Rule engine EWS (10-B) ---
# Jeda evaluasi aturan ambang terhadap data nyata (durasi Go). Bawaan 15m; "0" atau "off" mematikan.
# Evaluasi manual tetap tersedia lewat POST /v1/ews/evaluasi (izin ews.atur_ambang).
EWS_EVAL_INTERVAL=15m

# --- Notifikasi EWS (10-D) ---
# Notifikasi selalu dicatat di tabel ews_notifikasi (outbox). Pengiriman nyata hanya bila kanalnya
# dikonfigurasi: email lewat SMTP_* di bawah, push lewat kunci VAPID (buat dengan `npx web-push generate-vapid-keys`).
# Tanpa konfigurasi, baris outbox ditandai DICATAT dan tidak ada layanan luar yang dipanggil.
# Jeda pekerja pengiriman (durasi Go; "off" mematikan) dan eskalasi otomatis alert BARU >= SIAGA
# yang tidak diakui dalam N menit (0 = mati).
EWS_NOTIF_INTERVAL=30s
EWS_ESKALASI_MENIT=0
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ews@gardainflasi.id
# URL publik aplikasi untuk tautan di email notifikasi (opsional).
APP_PUBLIC_URL=

# --- Workflow intervensi (14-C) ---
# Alert EWS >= tingkat ini otomatis menjadi kartu intervensi (ditugasi ke unit manajemen program).
# INFO | WASPADA | SIAGA | KRITIS; "off" mematikan. Bawaan SIAGA.
INTERVENSI_KARTU_OTOMATIS_MIN=SIAGA
# Jeda pemeriksaan SLA tahap: kartu yang lebih lama di tahapnya daripada sla_hari dieskalasi otomatis
# (dan masuk antrean telaah Dewan Pengarah). Durasi Go, mis. 1h. Bawaan mati ("0" atau "off").
INTERVENSI_SLA_INTERVAL=0

# --- SMTP (opsional). Bila SMTP_HOST kosong, pengiriman email menjadi no-op (log saja). ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@gardainflasi.id
# SMTP_USERNAME kosong = tanpa autentikasi (relay dev/internal). Lokal tanpa Docker, tangkap email dengan
# Mailpit: `mailpit` (atau `docker run -p 8025:8025 -p 1025:1025 axllent/mailpit:v1.27.0`), lalu
# SMTP_HOST=localhost SMTP_PORT=1025; kotak masuk di http://localhost:8025. `make docker/demo/up` sudah
# menyalakan Mailpit sendiri (compose profil `mailpit`, port host MAILPIT_PORT, bawaan 8025). Jangan untuk produksi.
# Alamat publik aplikasi web untuk tautan di email (atur ulang kata sandi). Bawaan https://gardainflasi.id.
APP_PUBLIC_URL=http://localhost:3000

# ------------------------------------------------------------------------------
#  3. FRONTEND — Next.js 16  (apps/web)   -> salin ke apps/web/.env.local
# ------------------------------------------------------------------------------
# URL publik BFF Next.js. HARUS relatif ("/api"), bukan absolut: URL absolut
# membuat http://localhost dan https://localhost jadi origin berbeda → CORS.
# KOSONGKAN untuk mengaktifkan mode mock (tanpa backend).
NEXT_PUBLIC_API_BASE_URL=/api
# Origin aplikasi — dipakai validasi CSRF & safe-redirect pada lapisan BFF.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Mapbox (opsional). Kosong => peta memakai skema SVG Aceh.
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- BFF (server-only: hanya Route Handler / Server Action yang membacanya) ---
GO_API_BASE_URL=http://localhost:8080/v1
# Harus SAMA PERSIS dengan JWT_SECRET backend agar verifikasi JWT (jose) berhasil.
GARDA_JWT_SECRET=garda-inflasi-dev-secret-key-change-in-production
# Atribut Secure pada cookie token. Kosong => aktif hanya di produksi.
# Set false bila produksi/Docker diakses lewat http:// (mis. demo lokal).
COOKIE_SECURE=

# ------------------------------------------------------------------------------
#  4. POSTGRESQL CONTAINER — docker compose (nilai disamakan dgn DB_* di bagian 2)
# ------------------------------------------------------------------------------
POSTGRES_DB=garda_inflasi
POSTGRES_USER=garda
POSTGRES_PASSWORD=garda_secret

# ------------------------------------------------------------------------------
#  5. PGADMIN 4 — Web GUI PostgreSQL (http://localhost:5050)
# ------------------------------------------------------------------------------
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@gardainflasi.id
PGADMIN_PASSWORD=admin

# ------------------------------------------------------------------------------
#  6. MONGODB CONTAINER — compose.infra.yaml (localhost:27017)
# ------------------------------------------------------------------------------
MONGO_PORT=27017
MONGO_USER=garda
MONGO_PASSWORD=garda_secret
MONGO_DB=garda_inflasi
MONGO_URL=mongodb://garda:garda_secret@localhost:27017/garda_inflasi?authSource=admin

# Port host (compose.infra.yaml / compose.yaml). Bawaan: 5432, 6379, 80, 443, 5050, 27017.
# `make docker/demo/up` memakai port alternatif; lihat Makefile (DEMO_*).
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# PGADMIN_PORT=5050
# MONGO_PORT=27017
# CADDY_HTTP_PORT=80
# CADDY_HTTPS_PORT=443
