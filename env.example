# ==============================================================================
#  Garda Inflasi — Konfigurasi Environment (Local Development)
# ==============================================================================
#  Satu file env untuk seluruh monorepo (backend Go + frontend Next.js + Docker).
#
#  Cara pakai:
#      cp env.example .env        # backend & Docker memakai .env
#      cp env.example env.local   # lalu salin blok FRONTEND ke apps/web/.env.local
#
#  Bagaimana tiap komponen membaca konfigurasi ini:
#    • Docker Compose   : otomatis membaca `.env` di root (satu folder dgn compose.yaml)
#    • Backend Go (Gin) : membaca process env. Jalankan via `make dev/api`
#                         (Makefile memuat `.env` via `-include` + `export`),
#                         atau manual:  set -a; . ./.env; set +a
#    • Frontend Next.js : membaca apps/web/.env.local — salin blok "FRONTEND" (bagian 3)
#                         ke file tsb, atau jalankan via `make dev/web`.
# ==============================================================================

# ------------------------------------------------------------------------------
#  1. RUNTIME UMUM
# ------------------------------------------------------------------------------
NODE_ENV=development
TZ=Asia/Jakarta

# ------------------------------------------------------------------------------
#  2. BACKEND — Go / Gin  (apps/api)
# ------------------------------------------------------------------------------
# Alamat bind HTTP server (default :8080 bila kosong)
APP_ADDR=:8080
# Mode Gin: debug | release | test
GIN_MODE=debug

# --- PostgreSQL — dibaca oleh pkg/database (prefix DB_) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=garda
DB_PASSWORD=garda_secret
DB_NAME=garda_inflasi
DB_SSLMODE=disable

# --- DSN tunggal — dipakai cmd/seed & goose (Makefile: db/migrate, db/seed) ---
DATABASE_URL=postgres://garda:garda_secret@localhost:5432/garda_inflasi?sslmode=disable

# --- Autentikasi & kriptografi ---
# JWT HS256 — minimal 32 karakter. WAJIB sama dengan GARDA_JWT_SECRET (frontend).
JWT_SECRET=garda-inflasi-dev-secret-key-change-in-production
# AES-256-GCM — WAJIB tepat 32 byte (32 karakter ASCII).
AES_KEY=0123456789abcdef0123456789abcdef

# --- Redis — cache / rate-limit (bagian dari tech stack) ---
REDIS_URL=redis://localhost:6379

# --- SMTP (opsional). Bila SMTP_HOST kosong, pengiriman email menjadi no-op (log saja). ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@garda-inflasi.id

# ------------------------------------------------------------------------------
#  3. FRONTEND — Next.js 16  (apps/web)   -> salin ke apps/web/.env.local
# ------------------------------------------------------------------------------
# URL publik layanan Go. KOSONGKAN untuk mengaktifkan mode mock (tanpa backend).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# Origin aplikasi — dipakai validasi CSRF & safe-redirect pada lapisan BFF.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Mapbox (opsional). Kosong => peta memakai skema SVG Aceh.
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- BFF (server-only: hanya Route Handler / Server Action yang membacanya) ---
GO_API_BASE_URL=http://localhost:8080/v1
# Harus SAMA PERSIS dengan JWT_SECRET backend agar verifikasi JWT (jose) berhasil.
GARDA_JWT_SECRET=garda-inflasi-dev-secret-key-change-in-production

# ------------------------------------------------------------------------------
#  4. POSTGRESQL CONTAINER — docker compose (nilai disamakan dgn DB_* di bagian 2)
# ------------------------------------------------------------------------------
POSTGRES_DB=garda_inflasi
POSTGRES_USER=garda
POSTGRES_PASSWORD=garda_secret
