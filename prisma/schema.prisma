// ═══════════════════════════════════════════════════════════════════
// AI Garda Inflasi — skema PostgreSQL
// Dipakai Prisma untuk migrasi + seeder; layanan Go membaca tabel yang sama
// (nama tabel snake_case via @@map agar ramah sqlc/pgx).
// ═══════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enum ───────────────────────────────────────────────────────────
enum Lapis {
  STRATEGIS
  MANAJERIAL
  OPERASIONAL
  SISTEM
}

enum Peran {
  STRATEGIS_FMIPA
  STRATEGIS_BI
  STRATEGIS_BPS
  STRATEGIS_DJPB
  MANAJER_PROGRAM
  MANAJER_DATA
  MANAJER_KEBIJAKAN
  MANAJER_PEMBIAYAAN
  MANAJER_RISIKO
  MANAJER_MUTU
  OPS_KOORDINATOR
  OPS_AGREGATOR
  OPS_MAHASISWA
  ADMIN_SISTEM
}

enum StatusAkun {
  AKTIF
  NONAKTIF
  MENUNGGU
}

enum StatusMaster {
  AKTIF
  MENUNGGU_PERSETUJUAN
  DIARSIPKAN
}

enum TipeHarga {
  PRODUSEN
  KONSUMEN
}

enum Kualitas {
  PREMIUM
  MEDIUM
  ASALAN
}

enum StatusEntri {
  DRAF
  DIAJUKAN
  DIVALIDASI
  DIPUBLIKASI
  DITOLAK
}

enum SumberHarga {
  LAPANGAN
  PIHPS
  BAPANAS
  PORTAL_DAERAH
}

enum Severity {
  INFO
  WASPADA
  SIAGA
  KRITIS
}

enum JenisEws {
  LONJAKAN_HARGA
  KELANGKAAN_STOK
  ANOMALI_CUACA
  OVER_SUPPLY
  ANOMALI_DATA
}

enum StatusEws {
  BARU
  DIAKUI
  DIESKALASI
  SELESAI
}

enum Siklus {
  NORMAL
  TEKANAN
  SURPLUS
}

enum Prioritas {
  TINGGI
  SEDANG
  RENDAH
}

enum StatusFasilitas {
  OPERASIONAL
  PERAWATAN
  RENCANA
}

enum StatusBrief {
  DRAF
  TELAAH
  DISETUJUI
  DIDISTRIBUSIKAN
}

enum StatusTugas {
  BELUM
  BERJALAN
  SELESAI
  TERLAMBAT
}

enum JenisSumber {
  API
  SCRAPER
}

enum StatusSumber {
  SEHAT
  TERTUNDA
  GAGAL
  DIJEDA
}

enum StatusPersetujuan {
  MENUNGGU
  DISETUJUI
  DITOLAK
}

enum StatusModel {
  PRODUKSI
  KANDIDAT
  ARSIP
}

// ── Master data (standar kode BPS) ─────────────────────────────────
model Provinsi {
  kode      String      @id @db.VarChar(2)
  nama      String
  kabupaten Kabupaten[]

  @@map("provinsi")
}

model Kabupaten {
  kode         String          @id @db.VarChar(4)
  nama         String
  jenis        String // Kabupaten | Kota
  ibukota      String
  lat          Float
  lng          Float
  provinsiKode String          @map("provinsi_kode")
  provinsi     Provinsi        @relation(fields: [provinsiKode], references: [kode])
  pasar        Pasar[]
  pengguna     Pengguna[]
  cuaca        CuacaHarian[]
  ews          EwsAlert[]
  coldStorage  ColdStorage[]
  intervensi   Intervensi[]
  prediksi     PrediksiHarga[]

  @@map("kabupaten")
}

model Pasar {
  id            String          @id
  nama          String
  kabupatenKode String          @map("kabupaten_kode")
  kabupaten     Kabupaten       @relation(fields: [kabupatenKode], references: [kode])
  lat           Float
  lng           Float
  radiusMeter   Int             @default(400) @map("radius_meter")
  aktif         Boolean         @default(true)
  entri         EntriHarga[]
  tugas         TugasLapangan[]

  @@index([kabupatenKode])
  @@map("pasar")
}

model Komoditas {
  kode          String            @id
  nama          String
  satuan        String
  kategori      String
  hargaAcuan    Int               @map("harga_acuan")
  pilot         Boolean           @default(false)
  shelfLifeHari Int               @map("shelf_life_hari")
  versi         Int               @default(1)
  status        StatusMaster      @default(AKTIF)
  entri         EntriHarga[]
  ews           EwsAlert[]
  aturanEws     AturanEws[]
  stok          StokColdStorage[]
  intervensi    Intervensi[]
  prediksi      PrediksiHarga[]
  model         ModelRegistry[]

  @@map("komoditas")
}

/// Versioning & approval perubahan master data (komoditas, wilayah, pasar, satuan).
model PerubahanMaster {
  id              String            @id @default(cuid())
  entitas         String
  entitasId       String            @map("entitas_id")
  versi           Int
  perubahan       Json
  status          StatusPersetujuan @default(MENUNGGU)
  diajukanOlehId  String            @map("diajukan_oleh_id")
  diajukanOleh    Pengguna          @relation("PerubahanDiajukan", fields: [diajukanOlehId], references: [id])
  disetujuiOlehId String?           @map("disetujui_oleh_id")
  disetujuiOleh   Pengguna?         @relation("PerubahanDisetujui", fields: [disetujuiOlehId], references: [id])
  dibuatPada      DateTime          @default(now()) @map("dibuat_pada")

  @@index([entitas, entitasId])
  @@map("perubahan_master")
}

// ── Akses (RBAC 3 lapis + sistem) ──────────────────────────────────
model Pengguna {
  id                 String            @id
  nama               String
  email              String            @unique
  passwordHash       String?           @map("password_hash") // null bila hanya SSO
  peran              Peran
  lapis              Lapis
  lembaga            String
  kabupatenKode      String?           @map("kabupaten_kode")
  kabupaten          Kabupaten?        @relation(fields: [kabupatenKode], references: [kode])
  mfaAktif           Boolean           @default(false) @map("mfa_aktif")
  status             StatusAkun        @default(AKTIF)
  terakhirMasuk      DateTime?         @map("terakhir_masuk")
  dibuatPada         DateTime          @default(now()) @map("dibuat_pada")
  entri              EntriHarga[]      @relation("EntriPetugas")
  validasi           EntriHarga[]      @relation("EntriValidator")
  publikasi          EntriHarga[]      @relation("EntriPublisher")
  ewsDiakui          EwsAlert[]
  intervensiDibuat   Intervensi[]      @relation("IntervensiPembuat")
  intervensiPj       Intervensi[]      @relation("IntervensiPJ")
  brief              PolicyBrief[]
  tugas              TugasLapangan[]
  audit              AuditLog[]
  perubahanDiajukan  PerubahanMaster[] @relation("PerubahanDiajukan")
  perubahanDisetujui PerubahanMaster[] @relation("PerubahanDisetujui")

  @@index([peran])
  @@map("pengguna")
}

// ── Layer 1: ingesti data ──────────────────────────────────────────
model EntriHarga {
  id              String      @id @default(cuid())
  komoditasKode   String      @map("komoditas_kode")
  komoditas       Komoditas   @relation(fields: [komoditasKode], references: [kode])
  pasarId         String      @map("pasar_id")
  pasar           Pasar       @relation(fields: [pasarId], references: [id])
  tipe            TipeHarga
  harga           Int
  satuan          String
  kualitas        Kualitas    @default(MEDIUM)
  sumber          SumberHarga @default(LAPANGAN)
  status          StatusEntri @default(DIAJUKAN)
  deviasiPct      Float       @default(0) @map("deviasi_pct")
  skorAnomali     Float       @default(0) @map("skor_anomali")
  lat             Float?
  lng             Float?
  dalamGeofence   Boolean     @default(true) @map("dalam_geofence")
  fotoUrl         String?     @map("foto_url")
  kodePedagang    String?     @map("kode_pedagang")
  catatan         String?
  idempotencyKey  String?     @unique @map("idempotency_key")
  dicatatPada     DateTime    @map("dicatat_pada")
  petugasId       String?     @map("petugas_id")
  petugas         Pengguna?   @relation("EntriPetugas", fields: [petugasId], references: [id])
  divalidasiOleh  String?     @map("divalidasi_oleh")
  validator       Pengguna?   @relation("EntriValidator", fields: [divalidasiOleh], references: [id])
  divalidasiPada  DateTime?   @map("divalidasi_pada")
  dipublikasiOleh String?     @map("dipublikasi_oleh")
  publisher       Pengguna?   @relation("EntriPublisher", fields: [dipublikasiOleh], references: [id])

  @@index([komoditasKode, pasarId, dicatatPada])
  @@index([status, dicatatPada])
  @@map("entri_harga")
}

model CuacaHarian {
  id            String    @id @default(cuid())
  kabupatenKode String    @map("kabupaten_kode")
  kabupaten     Kabupaten @relation(fields: [kabupatenKode], references: [kode])
  tanggal       DateTime  @db.Date
  curahHujanMm  Float     @map("curah_hujan_mm")
  suhuC         Float     @map("suhu_c")
  kelembapan    Int
  anomali       Boolean   @default(false)
  sumber        String    @default("BMKG")

  @@unique([kabupatenKode, tanggal, sumber])
  @@map("cuaca_harian")
}

model SumberData {
  id             String       @id
  nama           String
  penyedia       String
  jenis          JenisSumber
  cakupan        String
  jadwalCron     String       @map("jadwal_cron")
  status         StatusSumber @default(SEHAT)
  terakhirJalan  DateTime?    @map("terakhir_jalan")
  keberhasilan7h Float        @default(100) @map("keberhasilan_7h")
  latensiMs      Int          @default(0) @map("latensi_ms")
  robotsTxtPatuh Boolean      @default(true) @map("robots_txt_patuh")
  atribusi       String

  @@map("sumber_data")
}

// ── Layer 2: analitik & EWS ────────────────────────────────────────
model AturanEws {
  id            String     @id @default(cuid())
  komoditasKode String?    @map("komoditas_kode")
  komoditas     Komoditas? @relation(fields: [komoditasKode], references: [kode])
  jenis         JenisEws
  ambangWaspada Float      @map("ambang_waspada")
  ambangSiaga   Float      @map("ambang_siaga")
  ambangKritis  Float      @map("ambang_kritis")
  jendelaHari   Int        @default(7) @map("jendela_hari")
  kanal         String[]   @default(["DASHBOARD", "PUSH"])
  aktif         Boolean    @default(true)

  @@map("aturan_ews")
}

model EwsAlert {
  id            String        @id
  severity      Severity
  jenis         JenisEws
  judul         String
  pesan         String
  komoditasKode String?       @map("komoditas_kode")
  komoditas     Komoditas?    @relation(fields: [komoditasKode], references: [kode])
  kabupatenKode String        @map("kabupaten_kode")
  kabupaten     Kabupaten     @relation(fields: [kabupatenKode], references: [kode])
  nilai         Float
  satuanNilai   String        @map("satuan_nilai")
  skorDampak    Int           @map("skor_dampak")
  status        StatusEws     @default(BARU)
  sumber        String
  dibuatPada    DateTime      @default(now()) @map("dibuat_pada")
  diakuiOlehId  String?       @map("diakui_oleh_id")
  diakuiOleh    Pengguna?     @relation(fields: [diakuiOlehId], references: [id])
  diakuiPada    DateTime?     @map("diakui_pada")
  intervensi    Intervensi[]

  @@index([status, severity])
  @@map("ews_alert")
}

model ModelRegistry {
  id            String      @id @default(cuid())
  komoditasKode String      @map("komoditas_kode")
  komoditas     Komoditas   @relation(fields: [komoditasKode], references: [kode])
  nama          String
  versi         String
  mape          Float
  drift         Float       @default(0) // PSI
  status        StatusModel @default(KANDIDAT)
  dilatihPada   DateTime    @map("dilatih_pada")

  @@unique([komoditasKode, versi])
  @@map("model_registry")
}

model PrediksiHarga {
  id            String    @id @default(cuid())
  komoditasKode String    @map("komoditas_kode")
  komoditas     Komoditas @relation(fields: [komoditasKode], references: [kode])
  kabupatenKode String    @map("kabupaten_kode")
  kabupaten     Kabupaten @relation(fields: [kabupatenKode], references: [kode])
  tanggalTarget DateTime  @map("tanggal_target") @db.Date
  horizonHari   Int       @map("horizon_hari")
  nilai         Int
  bawah         Int
  atas          Int
  modelVersi    String    @map("model_versi")
  faktor        Json      // kontribusi XAI [{nama, kontribusi, detail}]
  dibuatPada    DateTime  @default(now()) @map("dibuat_pada")

  @@index([komoditasKode, kabupatenKode, tanggalTarget])
  @@map("prediksi_harga")
}

model ColdStorage {
  id           String            @id
  nama         String
  kabupatenKode String           @map("kabupaten_kode")
  kabupaten    Kabupaten         @relation(fields: [kabupatenKode], references: [kode])
  lat          Float
  lng          Float
  kapasitasTon Int               @map("kapasitas_ton")
  suhuTargetC  Float             @map("suhu_target_c")
  status       StatusFasilitas
  stok         StokColdStorage[]

  @@map("cold_storage")
}

model StokColdStorage {
  id             String      @id
  coldStorageId  String      @map("cold_storage_id")
  coldStorage    ColdStorage @relation(fields: [coldStorageId], references: [id], onDelete: Cascade)
  komoditasKode  String      @map("komoditas_kode")
  komoditas      Komoditas   @relation(fields: [komoditasKode], references: [kode])
  volumeTon      Float       @map("volume_ton")
  masukPada      DateTime    @map("masuk_pada")
  pemilik        String // agregator/produsen — kepemilikan tidak diambil alih
  risikoFoodLoss Float       @map("risiko_food_loss")

  @@map("stok_cold_storage")
}

// ── Layer 3: DSS ───────────────────────────────────────────────────
model RuangFiskal {
  id         String   @id @default(cuid())
  tahun      Int
  instrumen  String
  pagu       BigInt
  realisasi  BigInt
  perTanggal DateTime @map("per_tanggal") @db.Date

  @@unique([tahun, instrumen, perTanggal])
  @@map("ruang_fiskal")
}

model PolicyBrief {
  id            String      @id
  periode       String
  judul         String
  status        StatusBrief @default(DRAF)
  ringkasan     String
  rekomendasi   Json
  halaman       Int
  disusunOlehId String      @map("disusun_oleh_id")
  disusunOleh   Pengguna    @relation(fields: [disusunOlehId], references: [id])
  diperbarui    DateTime    @updatedAt

  @@map("policy_brief")
}

// ── Layer 4: intervensi & tugas ────────────────────────────────────
model Intervensi {
  id               String     @id
  siklus           Siklus
  tahap            String // id tahap, mis. "t-verifikasi" (lihat lib/data/siklus.ts)
  urutan           Int        @default(0)
  judul            String
  komoditasKode    String     @map("komoditas_kode")
  komoditas        Komoditas  @relation(fields: [komoditasKode], references: [kode])
  kabupatenKode    String     @map("kabupaten_kode")
  kabupaten        Kabupaten  @relation(fields: [kabupatenKode], references: [kode])
  prioritas        Prioritas
  tenggat          DateTime
  rekomendasiAi    Boolean    @default(false) @map("rekomendasi_ai")
  checklistSelesai Int        @default(0) @map("checklist_selesai")
  checklistTotal   Int        @default(0) @map("checklist_total")
  ewsAlertId       String?    @map("ews_alert_id")
  ewsAlert         EwsAlert?  @relation(fields: [ewsAlertId], references: [id])
  dibuatOlehId     String     @map("dibuat_oleh_id")
  dibuatOleh       Pengguna   @relation("IntervensiPembuat", fields: [dibuatOlehId], references: [id])
  penanggungJawab  Pengguna[] @relation("IntervensiPJ")
  dibuatPada       DateTime   @default(now()) @map("dibuat_pada")

  @@index([siklus, tahap, urutan])
  @@map("intervensi")
}

model TugasLapangan {
  id        String      @id
  judul     String
  pasarId   String      @map("pasar_id")
  pasar     Pasar       @relation(fields: [pasarId], references: [id])
  petugasId String      @map("petugas_id")
  petugas   Pengguna    @relation(fields: [petugasId], references: [id])
  komoditas String[]
  tipe      TipeHarga
  tenggat   DateTime
  status    StatusTugas @default(BELUM)
  target    Int

  @@index([petugasId, status])
  @@map("tugas_lapangan")
}

// ── Tata kelola ────────────────────────────────────────────────────
model AuditLog {
  id        String   @id @default(cuid())
  waktu     DateTime @default(now())
  aktorId   String?  @map("aktor_id")
  aktor     Pengguna? @relation(fields: [aktorId], references: [id])
  aksi      String
  entitas   String
  entitasId String   @map("entitas_id")
  hasil     String // BERHASIL | DITOLAK
  ip        String?
  metadata  Json?

  @@index([entitas, entitasId])
  @@index([waktu])
  @@map("audit_log")
}
